---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../data/projects';
import { withBase } from '../../utils/url';
import { ArrowLeft, Clock, Layers, Github, CheckCircle2, ChevronRight } from 'lucide-astro';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const allProjectsUrl = withBase('/#projects');
const statusStyles = {
  'In Progress': 'bg-cyan-950/80 text-cyan-300 border-cyan-700/70',
  'Planned': 'bg-amber-950/80 text-amber-300 border-amber-800/70',
  'Completed': 'bg-emerald-950/80 text-emerald-300 border-emerald-700/70',
};
---

<BaseLayout
  title={`${project.title} | Technical Architecture Case Study`}
  description={project.summary}
>
  <div class="py-12 sm:py-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Navigation Back -->
    <div class="mb-8">
      <a
        href={allProjectsUrl}
        class="inline-flex items-center space-x-2 text-sm font-medium text-slate-400 hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-400 rounded py-1 px-2 -ml-2"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Back to Portfolio Projects</span>
      </a>
    </div>

    <!-- Article Header -->
    <header class="space-y-4 pb-8 border-b border-slate-800">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-xs font-mono font-medium text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
          <Layers class="w-3.5 h-3.5 text-cyan-400" />
          <span>{project.category}</span>
        </span>

        <span class={`text-[11px] font-mono px-2.5 py-0.5 rounded-full border font-medium flex items-center gap-1.5 ${statusStyles[project.status]}`}>
          {project.status === 'In Progress' && <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>}
          {project.status === 'Planned' && <Clock class="w-3 h-3 text-amber-400" />}
          <span>{project.status}</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {project.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed font-normal">
        {project.summary}
      </p>

      {project.statusNote && (
        <div class="p-3.5 rounded-lg bg-navy-900/80 border border-slate-800 text-xs font-mono text-slate-400 flex items-center space-x-2">
          <Clock class="w-4 h-4 text-cyan-400 flex-shrink-0" />
          <span><strong>Project Status Note:</strong> {project.statusNote}</span>
        </div>
      )}
    </header>

    <!-- Main Content Body -->
    <div class="py-10 space-y-12">
      
      <!-- Section 1: The Architectural Challenge & Goal -->
      <section class="space-y-4">
        <div class="inline-flex items-center space-x-2 text-xs font-mono text-cyan-400 font-semibold tracking-wider uppercase">
          <span>01 // Problem Statement & Objectives</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">System Objectives & Design Scope</h2>
        <div class="p-4 rounded-xl bg-navy-900/70 border border-slate-800 text-sm text-slate-200 leading-relaxed">
          <strong class="text-cyan-400 font-mono text-xs uppercase tracking-wider block mb-1">Core Problem Addressed:</strong>
          {project.problemStatement}
        </div>
        <p class="text-base text-slate-300 leading-relaxed">
          {project.description}
        </p>
      </section>

      <!-- Section 2: Architecture Breakdown & Component Pipeline -->
      <section class="space-y-6">
        <div class="inline-flex items-center space-x-2 text-xs font-mono text-cyan-400 font-semibold tracking-wider uppercase">
          <span>02 // System Architecture</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Component Breakdown & Data Flow</h2>
        <p class="text-base text-slate-300 leading-relaxed">
          {project.architectureOverview}
        </p>

        {project.architectureComponents && (
          <div class="grid grid-cols-1 gap-3 pt-2">
            {project.architectureComponents.map((comp, idx) => (
              <div class="p-4 rounded-lg bg-navy-900/70 border border-slate-800/90 flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
                <div class="font-mono text-xs font-bold text-cyan-400 sm:w-48 flex-shrink-0">
                  {idx + 1}. {comp.name}
                </div>
                <div class="text-sm text-slate-300">
                  {comp.description}
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      <!-- Section 3: Key Engineering Decisions & Trade-Offs -->
      <section class="space-y-4">
        <div class="inline-flex items-center space-x-2 text-xs font-mono text-cyan-400 font-semibold tracking-wider uppercase">
          <span>03 // Architectural Decisions</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Engineering Trade-Offs & Rationale</h2>
        <div class="space-y-3">
          {project.keyDecisions.map((decision) => (
            <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-start space-x-3">
              <CheckCircle2 class="w-5 h-5 text-cyan-400 flex-shrink-0 mt-0.5" />
              <p class="text-sm text-slate-200 leading-relaxed">{decision}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Technology Stack -->
      <section class="space-y-4">
        <div class="inline-flex items-center space-x-2 text-xs font-mono text-cyan-400 font-semibold tracking-wider uppercase">
          <span>04 // Stack & Tooling</span>
        </div>
        <h2 class="text-2xl font-bold text-white tracking-tight">Technologies & Runtime Dependencies</h2>
        <div class="flex flex-wrap gap-2 pt-2">
          {project.technologies.map((tech) => (
            <span class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-200 border border-slate-700 font-mono text-xs font-medium">
              {tech}
            </span>
          ))}
        </div>
      </section>

      <!-- Section 5: Repository & Implementation Access -->
      <section class="p-6 rounded-xl bg-navy-900/60 border border-slate-800/90 space-y-3">
        <h3 class="text-lg font-bold text-white">Repository Status</h3>
        {project.repoUrl ? (
          <div class="flex items-center space-x-4">
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-cyan-500 text-slate-950 font-semibold text-sm hover:bg-cyan-400 transition-colors"
            >
              <Github class="w-4 h-4" />
              <span>Browse Source Code</span>
            </a>
          </div>
        ) : (
          <p class="text-xs sm:text-sm text-slate-400 font-mono leading-relaxed">
            This project is currently under local iterative development and testing. Once the implementation reaches baseline quality benchmarks and documentation criteria, the public repository link will be posted here.
          </p>
        )}
      </section>

    </div>

    <!-- Footer Navigation between projects -->
    <div class="pt-8 border-t border-slate-800 flex items-center justify-between">
      <a
        href={allProjectsUrl}
        class="inline-flex items-center space-x-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Return to All Work</span>
      </a>

      <a
        href={withBase('/#contact')}
        class="inline-flex items-center space-x-2 text-sm font-semibold text-slate-300 hover:text-white transition-colors"
      >
        <span>Discuss this Architecture</span>
        <ChevronRight class="w-4 h-4" />
      </a>
    </div>

  </div>
</BaseLayout>
