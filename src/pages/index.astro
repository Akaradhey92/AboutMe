---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Expertise from '../components/Expertise.astro';
import EngineeringImpact from '../components/EngineeringImpact.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Philosophy from '../components/Philosophy.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import Contact from '../components/Contact.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title={`${siteConfig.name} | Senior Software Engineer (.NET, Azure & AI Systems)`}
  description={siteConfig.meta.description}
>
  <!-- Hero Section -->
  <Hero />

  <!-- 01: Technical Expertise Section -->
  <Expertise />

  <!-- 02: Engineering Impact (Enterprise Initiatives Centerpiece) -->
  <EngineeringImpact />

  <!-- 03: Professional Experience Timeline -->
  <ExperienceTimeline />

  <!-- 04: Engineering Philosophy -->
  <Philosophy />

  <!-- 05: Personal Projects & Engineering Lab -->
  <ProjectsSection />

  <!-- 06: Contact & Collaboration -->
  <Contact />
</BaseLayout>
