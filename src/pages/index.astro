---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Expertise from '../components/Expertise.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Philosophy from '../components/Philosophy.astro';
import Contact from '../components/Contact.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title={`${siteConfig.name} | Senior Software Engineer (.NET, Azure & AI Systems)`}
  description={siteConfig.meta.description}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Technical Expertise Section -->
  <Expertise />

  <!-- Featured Projects & Architectures -->
  <ProjectsSection />

  <!-- Professional Experience Timeline -->
  <ExperienceTimeline />

  <!-- Engineering Philosophy -->
  <Philosophy />

  <!-- Contact & Collaboration -->
  <Contact />
</BaseLayout>

