---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Expertise from '../components/Expertise.astro';
import EngineeringImpact from '../components/EngineeringImpact.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Contact from '../components/Contact.astro';
import { siteConfig } from '../data/siteConfig';
---

<BaseLayout
  title={`${siteConfig.name} | Senior Software Engineer (.NET, Azure & AI Systems)`}
  description={siteConfig.meta.description}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Selected professional contributions -->
  <EngineeringImpact />

  <!-- Work history and education -->
  <ExperienceTimeline />

  <!-- Core skills -->
  <Expertise />

  <!-- Contact -->
  <Contact />
</BaseLayout>
