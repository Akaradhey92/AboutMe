---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
import { Info, FlaskConical } from 'lucide-astro';
---

<section id="lab" class="py-16 sm:py-24 border-t border-slate-800/80 bg-navy-950/40 relative">
  <!-- Anchor alias for backward-compatible links -->
  <span id="projects" class="sr-only" aria-hidden="true"></span>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-3xl text-left">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-400 text-xs font-mono mb-4">
          <FlaskConical class="w-3.5 h-3.5" />
          <span>05 // PERSONAL PROJECTS & ENGINEERING LAB</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Personal Projects & Engineering Lab
        </h2>
        <p class="mt-3.5 text-base sm:text-lg text-slate-300 leading-relaxed">
          Independent architectural reference designs, sandbox prototypes, and exploratory systems developed outside of enterprise production platforms.
        </p>
      </div>

      <!-- Authenticity Disclaimer / Notice -->
      <div class="p-4 rounded-xl bg-navy-900/60 border border-slate-800/80 max-w-sm text-left flex-shrink-0">
        <div class="flex items-center space-x-2 text-xs font-mono text-cyan-400 mb-1">
          <Info class="w-3.5 h-3.5 flex-shrink-0" />
          <span class="font-semibold uppercase">Lab Transparency Standard</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          These exploratory projects are honestly marked as <span class="text-cyan-300 font-semibold">In Progress</span> or <span class="text-amber-300 font-semibold">Planned</span>. No fabricated metrics, repos, or completion claims.
        </p>
      </div>
    </div>

    <!-- Projects Grid (4 personal project cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

  </div>
</section>
