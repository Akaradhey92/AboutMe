---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/url';
import { ArrowRight, Mail, MapPin, FileText } from 'lucide-astro';
---

<section id="about" class="py-14 sm:py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl">
      <p class="flex items-center gap-2 text-sm font-mono text-slate-400 mb-6">
        <MapPin class="w-4 h-4 text-cyan-400" aria-hidden="true" />
        {siteConfig.location}
      </p>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
        {siteConfig.name}
        <span class="block mt-3 text-2xl sm:text-4xl text-cyan-300 font-semibold">
          {siteConfig.currentRole}
        </span>
      </h1>
      <p class="mt-7 text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl">
        {siteConfig.shortBio}
      </p>
      <p class="mt-4 text-sm sm:text-base text-slate-400 leading-relaxed max-w-3xl">
        My approach is pragmatic: keep systems maintainable, make delivery repeatable,
        and work closely with architects and developers.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={withBase('/#impact')} class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-slate-950 bg-cyan-400 hover:bg-cyan-300 rounded-lg transition-colors">
          View Selected Work <ArrowRight class="w-4 h-4" aria-hidden="true" />
        </a>
        <a href={withBase('/#contact')} class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-slate-200 bg-slate-900 border border-slate-700 hover:bg-slate-800 rounded-lg transition-colors">
          <Mail class="w-4 h-4 text-cyan-400" aria-hidden="true" /> Get In Touch
        </a>
        <a href={withBase(siteConfig.social.resumePdf)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-3 text-sm font-medium text-slate-300 hover:text-white rounded-lg transition-colors">
          <FileText class="w-4 h-4" aria-hidden="true" /> Résumé (PDF)
        </a>
      </div>
    </div>
  </div>
</section>
