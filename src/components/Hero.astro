---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/url';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import { ArrowRight, Mail, Sparkles, MapPin, Briefcase, FileText, CheckCircle2 } from 'lucide-astro';

const impactUrl = withBase('/#impact');
const contactUrl = withBase('/#contact');
const resumeUrl = withBase(siteConfig.social.resumePdf);
---

<section id="about" class="relative pt-8 pb-16 sm:pt-14 sm:pb-24 lg:pt-20 lg:pb-28 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Text & Value Proposition (7 cols on desktop) -->
      <div class="lg:col-span-7 space-y-6 text-left">
        
        <!-- Live Role & Location Pill -->
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/70 shadow-inner">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse" aria-hidden="true"></span>
          <span class="text-xs font-mono font-medium text-slate-300 flex items-center gap-1.5 flex-wrap">
            <MapPin class="w-3.5 h-3.5 text-cyan-400" />
            <span>{siteConfig.location}</span>
            <span class="text-slate-500">•</span>
            <Briefcase class="w-3.5 h-3.5 text-slate-400" />
            <span>{siteConfig.currentRole} at <strong class="text-slate-100 font-semibold">{siteConfig.currentCompany}</strong></span>
          </span>
        </div>

        <!-- Main Headline with strong hierarchy -->
        <div class="space-y-3">
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.14]">
            Building Reliable Software.
            <span class="block bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-400 bg-clip-text text-transparent">
              Engineering Scalable Systems.
            </span>
          </h1>
        </div>

        <!-- Concise & Authentic Lead Paragraph -->
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
          I am a backend-focused software engineer with <strong class="text-white font-semibold">12+ years of enterprise experience</strong> designing and operating resilient systems across <strong class="text-white font-semibold">.NET</strong>, <strong class="text-white font-semibold">Microsoft Azure</strong>, and modern web architectures. Currently expanding my capabilities into <strong class="text-cyan-300 font-semibold">applied AI engineering and RAG systems</strong>.
        </p>

        <!-- Focused Highlights Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1 max-w-xl">
          <div class="flex items-center space-x-2 text-sm text-slate-200">
            <CheckCircle2 class="w-4 h-4 text-cyan-400 flex-shrink-0" />
            <span class="font-medium">12+ Years Enterprise .NET & C#</span>
          </div>
          <div class="flex items-center space-x-2 text-sm text-slate-200">
            <CheckCircle2 class="w-4 h-4 text-cyan-400 flex-shrink-0" />
            <span class="font-medium">Microsoft Azure & Kubernetes (AKS)</span>
          </div>
          <div class="flex items-center space-x-2 text-sm text-slate-200">
            <CheckCircle2 class="w-4 h-4 text-cyan-400 flex-shrink-0" />
            <span class="font-medium">CI/CD (GitHub Actions & Azure DevOps)</span>
          </div>
          <div class="flex items-center space-x-2 text-sm text-slate-200">
            <CheckCircle2 class="w-4 h-4 text-purple-400 flex-shrink-0" />
            <span class="font-medium">Enterprise AI & Spec-Driven Delivery</span>
          </div>
        </div>

        <!-- Action CTAs: Work, Contact & Resume -->
        <div class="pt-3 flex flex-wrap items-center gap-3.5">
          <a
            href={impactUrl}
            class="inline-flex items-center space-x-2 px-5 py-2.5 text-sm font-semibold text-slate-950 bg-cyan-400 hover:bg-cyan-300 rounded-lg transition-all shadow-md hover:shadow-cyan-500/25 focus-visible:ring-2 focus-visible:ring-cyan-300"
          >
            <span>Explore Engineering Impact</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href={contactUrl}
            class="inline-flex items-center space-x-2 px-5 py-2.5 text-sm font-semibold text-slate-200 bg-slate-900/90 border border-slate-700/80 hover:bg-slate-800 hover:border-slate-600 rounded-lg transition-all focus-visible:ring-2 focus-visible:ring-cyan-400"
          >
            <Mail class="w-4 h-4 text-cyan-400" />
            <span>Get In Touch</span>
          </a>

          <a
            href={resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center space-x-2 px-4 py-2.5 text-sm font-medium text-slate-300 hover:text-white bg-slate-900/50 hover:bg-slate-800/80 border border-slate-800 hover:border-slate-700 rounded-lg transition-all focus-visible:ring-2 focus-visible:ring-cyan-400"
          >
            <FileText class="w-4 h-4 text-slate-400" />
            <span>Download Résumé</span>
          </a>
        </div>

        <!-- Career Direction Note -->
        <div class="pt-1">
          <p class="text-xs text-slate-400 flex items-center space-x-2 font-mono">
            <Sparkles class="w-3.5 h-3.5 text-cyan-400 flex-shrink-0" />
            <span>Growing toward Staff Engineer, Platform Architect, and AI Engineering roles.</span>
          </p>
        </div>

      </div>

      <!-- Architecture Visual / Topology (5 cols on desktop) -->
      <div class="lg:col-span-5 flex justify-center w-full">
        <ArchitectureDiagram />
      </div>

    </div>
  </div>
</section>
