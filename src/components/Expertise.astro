---
import { skillCategories, currentFocus } from '../data/skills';
import { Server, Monitor, Cloud, Database, BrainCircuit } from 'lucide-astro';
const icons = [Server, Monitor, Cloud, Database, BrainCircuit];
---

<section id="expertise" class="py-14 sm:py-20 border-t border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Core Skills</h2>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
      {skillCategories.map((category, index) => {
        const Icon = icons[index];
        return (
          <div class="border-t border-slate-800 pt-5">
            <h3 class="flex items-center gap-2 text-base font-semibold text-white mb-4">
              <Icon class="w-4 h-4 text-cyan-400" aria-hidden="true" />
              {category.title}
            </h3>
            <ul class="space-y-2 text-sm text-slate-300">
              {category.skills.map((skill) => <li>{skill}</li>)}
            </ul>
          </div>
        );
      })}
    </div>
    <aside class="mt-8 border-l-2 border-cyan-600 pl-5 sm:pl-6" aria-labelledby="current-focus-title">
      <h3 id="current-focus-title" class="text-lg font-semibold text-white">Currently Working On</h3>
      <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl">{currentFocus}</p>
    </aside>
  </div>
</section>
