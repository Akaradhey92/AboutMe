---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/url';
import { Mail, Linkedin, Github, FileText, Copy, Check, ExternalLink, Sparkles } from 'lucide-astro';

const resumeUrl = withBase(siteConfig.social.resumePdf);
---

<section id="contact" class="py-16 sm:py-20 border-t border-slate-800/80 bg-[#060911] relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with correct 05 numbering -->
    <div class="max-w-3xl mb-12 text-left">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-400 text-xs font-mono mb-4">
        <span>05 // INITIATE CONTACT</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Let's Connect & Collaborate
      </h2>
      <p class="mt-3.5 text-base sm:text-lg text-slate-300 leading-relaxed">
        Whether you are seeking an experienced senior engineer for high-impact backend systems, cloud architecture guidance, or technical exploration in AI workflows, I would welcome the conversation.
      </p>
    </div>

    <!-- Engagement Opportunities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      
      <div class="p-6 rounded-xl bg-navy-900/60 border border-slate-800/90 hover:border-slate-700 transition-colors">
        <div class="w-9 h-9 rounded-lg bg-cyan-950 text-cyan-400 border border-cyan-800/80 flex items-center justify-center mb-4">
          <Sparkles class="w-4 h-4" />
        </div>
        <h3 class="text-base font-bold text-white mb-2">Software Engineering</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          High-performance .NET backend services, distributed systems, clean architecture, and modernizing legacy monoliths.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-navy-900/60 border border-slate-800/90 hover:border-slate-700 transition-colors">
        <div class="w-9 h-9 rounded-lg bg-cyan-950 text-cyan-400 border border-cyan-800/80 flex items-center justify-center mb-4">
          <FileText class="w-4 h-4" />
        </div>
        <h3 class="text-base font-bold text-white mb-2">Cloud & Architecture Consulting</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Microsoft Azure infrastructure design, Service Bus messaging, database query optimization, and CI/CD pipelines.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-navy-900/60 border border-slate-800/90 hover:border-slate-700 transition-colors">
        <div class="w-9 h-9 rounded-lg bg-cyan-950 text-cyan-400 border border-cyan-800/80 flex items-center justify-center mb-4">
          <Mail class="w-4 h-4" />
        </div>
        <h3 class="text-base font-bold text-white mb-2">Technical Collaborations</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Applied RAG development, knowledge ingestion systems, open-source tooling, and hands-on architecture deep dives.
        </p>
      </div>

    </div>

    <!-- Contact Action Center Card -->
    <div class="rounded-2xl bg-gradient-to-br from-navy-900 to-[#0c1424] border border-cyan-900/40 p-7 sm:p-10 shadow-2xl relative overflow-hidden">
      
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-4 text-left">
          <span class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider">
            Direct Communication
          </span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Reach Out Directly
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed">
            I respond promptly to technical inquiries, architectural discussions, and engineering opportunities. Reach out via email or connect on LinkedIn.
          </p>

          <!-- Email Copy Pill -->
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold text-sm transition-all shadow-md focus-visible:ring-2 focus-visible:ring-cyan-300"
            >
              <Mail class="w-4 h-4" />
              <span>Send an Email</span>
            </a>

            <!-- Copy button with JavaScript feedback -->
            <button
              type="button"
              id="copy-email-button"
              data-email={siteConfig.social.email}
              class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-lg bg-slate-900 border border-slate-700/80 hover:bg-slate-800 text-slate-200 text-sm font-medium transition-all focus-visible:ring-2 focus-visible:ring-cyan-400"
              aria-label="Copy email address to clipboard"
            >
              <Copy class="w-4 h-4 text-slate-400 copy-icon" />
              <Check class="w-4 h-4 text-emerald-400 check-icon hidden" />
              <span class="copy-text font-mono text-xs">{siteConfig.social.email}</span>
            </button>
          </div>
          <p id="copy-status" class="text-xs text-emerald-400 font-mono hidden">✓ Email copied to clipboard!</p>
        </div>

        <!-- Social & Resume Links (5 cols) -->
        <div class="lg:col-span-5 flex flex-col space-y-3 pt-4 lg:pt-0 lg:border-l lg:border-slate-800/80 lg:pl-8">
          
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-cyan-800/80 hover:bg-slate-850 text-slate-200 hover:text-white transition-all group"
          >
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded-lg bg-blue-950/80 border border-blue-800/60 flex items-center justify-center text-blue-400">
                <Linkedin class="w-4 h-4" />
              </div>
              <div>
                <span class="text-sm font-semibold block">LinkedIn Profile</span>
                <span class="text-xs text-slate-300 font-mono">Connect professionally</span>
              </div>
            </div>
            <ExternalLink class="w-4 h-4 text-slate-500 group-hover:text-cyan-400 transition-colors" />
          </a>

          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-cyan-800/80 hover:bg-slate-850 text-slate-200 hover:text-white transition-all group"
          >
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center text-slate-200">
                <Github class="w-4 h-4" />
              </div>
              <div>
                <span class="text-sm font-semibold block">GitHub Profile</span>
                <span class="text-xs text-slate-300 font-mono">Code repositories & labs</span>
              </div>
            </div>
            <ExternalLink class="w-4 h-4 text-slate-500 group-hover:text-cyan-400 transition-colors" />
          </a>

          <a
            href={resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/80 border border-slate-800 hover:border-cyan-800/80 hover:bg-slate-850 text-slate-200 hover:text-white transition-all group"
          >
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded-lg bg-cyan-950/80 border border-cyan-800/60 flex items-center justify-center text-cyan-400">
                <FileText class="w-4 h-4" />
              </div>
              <div>
                <span class="text-sm font-semibold block">Curriculum Vitae</span>
                <span class="text-xs text-slate-300 font-mono">Download PDF document</span>
              </div>
            </div>
            <ExternalLink class="w-4 h-4 text-slate-500 group-hover:text-cyan-400 transition-colors" />
          </a>

        </div>

      </div>

      <!-- Informational note about direct contact -->
      <div class="mt-8 pt-6 border-t border-slate-800/80 text-xs text-slate-400 font-mono flex items-center justify-between flex-wrap gap-2">
        <span>Direct <code class="text-cyan-300">mailto:</code> link configured for immediate communication.</span>
        <span>Configurable in <code class="text-slate-300">src/data/siteConfig.ts</code></span>
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-button');
  const copyStatus = document.getElementById('copy-status');
  const copyIcon = copyBtn?.querySelector('.copy-icon');
  const checkIcon = copyBtn?.querySelector('.check-icon');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      copyStatus?.classList.remove('hidden');

      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        copyStatus?.classList.add('hidden');
      }, 3000);
    } catch (err) {
      const input = document.createElement('input');
      input.value = email;
      document.body.appendChild(input);
      input.select();
      document.execCommand('copy');
      document.body.removeChild(input);

      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      copyStatus?.classList.remove('hidden');

      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        copyStatus?.classList.add('hidden');
      }, 3000);
    }
  });
</script>
