---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/url';
import { Mail, Linkedin, Github, FileText, Copy, Check } from 'lucide-astro';
---

<section id="contact" class="py-14 sm:py-20 border-t border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Let’s Connect</h2>
    <p class="mt-4 text-base text-slate-300 leading-relaxed max-w-2xl">
      For engineering opportunities or a conversation about .NET, Azure, and enterprise AI,
      reach out by email or connect on LinkedIn.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a href={`mailto:${siteConfig.social.email}`} class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-semibold text-sm transition-colors">
        <Mail class="w-4 h-4" aria-hidden="true" /> Send an Email
      </a>
      <button type="button" id="copy-email-button" data-email={siteConfig.social.email} aria-label="Copy email address to clipboard" class="inline-flex items-center gap-2 px-4 py-3 rounded-lg bg-slate-900 border border-slate-700 hover:bg-slate-800 text-slate-200 text-sm transition-colors">
        <Copy class="w-4 h-4 text-slate-400 copy-icon" aria-hidden="true" />
        <Check class="w-4 h-4 text-emerald-400 check-icon hidden" aria-hidden="true" />
        <span class="font-mono text-xs">{siteConfig.social.email}</span>
      </button>
    </div>
    <p id="copy-status" role="status" aria-live="polite" aria-atomic="true" class="mt-3 min-h-5 text-xs text-slate-300"></p>
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-slate-300 hover:text-cyan-300 py-2">
        <Linkedin class="w-4 h-4" aria-hidden="true" /> LinkedIn
      </a>
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-slate-300 hover:text-cyan-300 py-2">
        <Github class="w-4 h-4" aria-hidden="true" /> GitHub
      </a>
      <a href={withBase(siteConfig.social.resumePdf)} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm text-slate-300 hover:text-cyan-300 py-2">
        <FileText class="w-4 h-4" aria-hidden="true" /> Résumé (PDF)
      </a>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-button');
  const copyStatus = document.getElementById('copy-status');
  const copyIcon = copyBtn?.querySelector('.copy-icon');
  const checkIcon = copyBtn?.querySelector('.check-icon');
  let resetTimer: ReturnType<typeof setTimeout> | undefined;

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;
    clearTimeout(resetTimer);
    copyIcon?.classList.remove('hidden');
    checkIcon?.classList.add('hidden');
    if (copyStatus) copyStatus.textContent = '';

    try {
      await navigator.clipboard.writeText(email);
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      if (copyStatus) copyStatus.textContent = 'Email copied to clipboard!';

      resetTimer = setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        if (copyStatus) copyStatus.textContent = '';
      }, 3000);
    } catch {
      if (copyStatus) {
        copyStatus.textContent = `Unable to copy automatically. Select and copy ${email}, or use Send an Email.`;
      }
    }
  });
</script>
