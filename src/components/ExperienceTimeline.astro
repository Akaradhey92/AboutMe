---
import { experiences, educationList } from '../data/experience';
import { Calendar, MapPin, CheckCircle2, Building, GraduationCap, Sparkles } from 'lucide-astro';
---

<section id="experience" class="py-16 sm:py-20 border-t border-slate-800/80 bg-[#060911] relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 text-left">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-400 text-xs font-mono mb-4">
        <span>03 // PROFESSIONAL EXPERIENCE</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Work History & Career Trajectory
      </h2>
      <p class="mt-3.5 text-base sm:text-lg text-slate-300 leading-relaxed">
        12+ years of enterprise software engineering experience building, modernizing, and leading mission-critical cloud and backend platforms.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative border-l-2 border-slate-800/90 ml-3.5 sm:ml-6 pl-6 sm:pl-8 space-y-10">
      {experiences.map((exp) => (
        <div class="relative group">
          
          <!-- Timeline Indicator Node -->
          <div class={`absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full border-4 ${
            exp.isCurrent
              ? 'bg-cyan-400 border-[#060911] ring-4 ring-cyan-500/20'
              : 'bg-slate-600 border-[#060911] ring-2 ring-slate-800'
          }`}></div>

          <!-- Card Content -->
          <div class="rounded-xl p-6 sm:p-7 border bg-navy-900/60 border-slate-800/90 hover:border-slate-700 hover:bg-navy-850/60 shadow-lg transition-all">
            
            <!-- Role Header Bar -->
            <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
              <div class="flex items-center space-x-2.5 flex-wrap">
                <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                  {exp.role}
                </h3>
                {exp.isCurrent && (
                  <span class="text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-cyan-950 text-cyan-300 border border-cyan-700/60 uppercase tracking-wide">
                    Current Role
                  </span>
                )}
                {exp.platform && (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-blue-950/60 text-blue-300 border border-blue-800/60">
                    {exp.platform}
                  </span>
                )}
              </div>

              <!-- Period -->
              <div class="flex items-center space-x-1.5 text-xs font-mono text-slate-400">
                <Calendar class="w-3.5 h-3.5 text-cyan-400" />
                <span>{exp.period}</span>
              </div>
            </div>

            <!-- Employer & Location -->
            <div class="flex items-center space-x-4 text-sm text-slate-300 mb-4 flex-wrap">
              <div class="flex items-center space-x-1.5">
                <Building class="w-4 h-4 text-slate-400" />
                <span class="text-white font-semibold">{exp.company}</span>
              </div>
              <div class="flex items-center space-x-1.5 text-slate-400">
                <MapPin class="w-3.5 h-3.5 text-slate-500" />
                <span>{exp.location}</span>
              </div>
            </div>

            <!-- Role Summary -->
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-5">
              {exp.summary}
            </p>

            <!-- Key Responsibilities -->
            <div class="space-y-2 mb-5">
              <h4 class="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-semibold">
                Key Technical Contributions
              </h4>
              <ul class="space-y-2">
                {exp.responsibilities.map((resp) => (
                  <li class="text-sm text-slate-300 flex items-start space-x-2.5 leading-relaxed">
                    <CheckCircle2 class="w-4 h-4 text-cyan-400 flex-shrink-0 mt-0.5" />
                    <span>{resp}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Pod-Based Engineering & Practices Highlight (if present) -->
            {exp.podPractices && (
              <div class="mb-5 p-4 sm:p-5 rounded-lg bg-navy-950/70 border border-cyan-800/40 relative overflow-hidden">
                <div class="flex items-center space-x-2 text-[11px] font-mono text-cyan-400 font-semibold uppercase tracking-wider mb-1.5">
                  <Sparkles class="w-3.5 h-3.5 text-cyan-400 flex-shrink-0" />
                  <span>{exp.podPractices.badge}</span>
                </div>
                <h4 class="text-sm sm:text-base font-bold text-white mb-1.5">
                  {exp.podPractices.title}
                </h4>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-3">
                  {exp.podPractices.description}
                </p>
                <ul class="space-y-1.5">
                  {exp.podPractices.points.map((pt) => (
                    <li class="text-xs sm:text-sm text-slate-300 flex items-start space-x-2 leading-relaxed">
                      <span class="text-cyan-400 font-mono flex-shrink-0 mt-0.5">•</span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Technologies -->
            <div class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-800/80">
              {exp.technologies.map((tech) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800/70 text-slate-300 border border-slate-700/60">
                  {tech}
                </span>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

    <!-- Education Section -->
    <div class="mt-14 pt-10 border-t border-slate-800/80">
      <div class="flex items-center space-x-2 text-xs font-mono text-cyan-400 mb-6 uppercase tracking-wider">
        <GraduationCap class="w-4 h-4" />
        <span>Education & Advanced Qualifications</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {educationList.map((edu) => (
          <div class="p-5 rounded-xl bg-navy-900/50 border border-slate-800/80 hover:border-slate-700 transition-colors">
            <h4 class="text-sm font-bold text-white mb-1">{edu.degree}</h4>
            <div class="text-xs text-slate-300 font-medium">{edu.institution} • {edu.location}</div>
            <div class="text-xs font-mono text-cyan-400 mt-2">{edu.year}</div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
