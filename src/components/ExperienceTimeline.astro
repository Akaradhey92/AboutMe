---
import { experiences, educationList, engineeringCollaboration } from '../data/experience';
import { GraduationCap } from 'lucide-astro';
---

<section id="experience" class="py-14 sm:py-20 border-t border-slate-800/80 bg-navy-900/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Experience</h2>
    <div class="mt-8 space-y-8">
      {experiences.map((experience) => (
        <article class="border-l-2 border-slate-800 pl-5 sm:pl-7">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
            <div>
              <h3 class="text-xl font-semibold text-white">{experience.role}</h3>
              <p class="mt-1 text-sm text-cyan-300">{experience.company} <span class="text-slate-400">· {experience.location}</span></p>
            </div>
            <p class="text-xs sm:text-sm font-mono text-slate-400 shrink-0">{experience.period}</p>
          </div>
          <p class="mt-4 text-sm text-slate-400">{experience.summary}</p>
          <ul class="mt-3 space-y-2 text-sm text-slate-300 leading-relaxed list-disc pl-4 max-w-3xl marker:text-cyan-400">
            {experience.responsibilities.map((responsibility) => <li>{responsibility}</li>)}
          </ul>
          {experience.isCurrent && (
            <aside class="mt-6 rounded-lg border border-cyan-900/50 bg-navy-900/60 p-5 sm:p-6" aria-labelledby="engineering-collaboration-title">
              <h4 id="engineering-collaboration-title" class="text-base font-semibold text-white">Engineering Collaboration</h4>
              <p class="mt-2 max-w-3xl text-sm text-slate-300 leading-relaxed">{engineeringCollaboration.summary}</p>
              <dl class="mt-5 grid grid-cols-1 md:grid-cols-3 gap-5">
                {engineeringCollaboration.areas.map((area) => (
                  <div>
                    <dt class="text-sm font-semibold text-cyan-200">{area.title}</dt>
                    <dd class="mt-2 text-sm text-slate-400 leading-relaxed">{area.description}</dd>
                  </div>
                ))}
              </dl>
            </aside>
          )}
        </article>
      ))}
    </div>
    <div class="mt-10 pt-7 border-t border-slate-800">
      <h3 class="flex items-center gap-2 text-base font-semibold text-white">
        <GraduationCap class="w-4 h-4 text-cyan-400" aria-hidden="true" /> Education
      </h3>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {educationList.map((education) => (
          <div>
            <p class="text-sm text-slate-200">{education.degree}</p>
            <p class="mt-1 text-xs text-slate-400">{education.institution}, {education.location} · {education.year}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
