---
import { engineeringImpacts, enterpriseAIContributions, modernizationCaseStudy } from '../data/impact';
import { Layers, Activity, ShieldCheck, GitBranch, ChevronDown } from 'lucide-astro';
const icons = [Layers, Activity, ShieldCheck, GitBranch];
---

<section id="impact" class="py-14 sm:py-20 border-t border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Selected Contributions</h2>
    <p class="mt-3 text-base text-slate-400">A few highlights from my work on the CCH SureTax platform at Wolters Kluwer.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-5">
      {engineeringImpacts.map((item, index) => {
        const Icon = icons[index];
        return (
          <article class="rounded-xl bg-navy-900/60 border border-slate-800 p-6 flex flex-col">
            <Icon class="w-5 h-5 text-cyan-400 mb-5" aria-hidden="true" />
            <h3 class="text-xl font-semibold text-white tracking-tight">{item.title}</h3>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.contribution}</p>
            <div class="mt-auto pt-5">
              <p class="pt-4 border-t border-slate-800 text-sm text-cyan-200 leading-relaxed">{item.outcome}</p>
            </div>
          </article>
        );
      })}
    </div>
    <details class="group mt-6 rounded-xl border border-slate-800 bg-navy-900/40">
      <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none rounded-xl hover:bg-slate-900/50 transition-colors [&::-webkit-details-marker]:hidden">
        <span>
          <span class="block text-base sm:text-lg font-semibold text-white">Read the Modernization Case Study</span>
          <span class="block mt-1 text-sm text-slate-400">.NET Framework to .NET Core at CCH SureTax</span>
        </span>
        <ChevronDown class="w-5 h-5 shrink-0 text-cyan-400 transition-transform group-open:rotate-180" aria-hidden="true" />
      </summary>
      <div class="px-6 pb-6 sm:px-8 sm:pb-8 border-t border-slate-800">
        <h3 class="pt-6 text-lg font-semibold text-cyan-200">{modernizationCaseStudy.title}</h3>
        <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          {modernizationCaseStudy.sections.map((section) => (
            <div>
              <h4 class="text-base font-semibold text-white">{section.title}</h4>
              <p class="mt-2 text-sm text-slate-300 leading-relaxed">{section.description}</p>
            </div>
          ))}
        </div>
      </div>
    </details>
    <div class="mt-12">
      <h3 class="text-2xl font-semibold text-white tracking-tight">Applied Enterprise AI</h3>
      <p class="mt-3 text-base text-slate-400">Hands-on contributions to AI-enabled workflows within CCH SureTax.</p>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-5">
        {enterpriseAIContributions.map((item) => (
          <article class="rounded-xl bg-navy-900/60 border border-slate-800 p-6 flex flex-col">
            <h4 class="text-lg font-semibold text-white tracking-tight">{item.title}</h4>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.summary}</p>
            <details class="group mt-auto pt-5">
              <summary class="flex items-center justify-between gap-3 cursor-pointer list-none rounded text-sm font-medium text-cyan-300 hover:text-cyan-200 [&::-webkit-details-marker]:hidden">
                <span>Implementation details<span class="sr-only">: {item.title}</span></span>
                <ChevronDown class="w-4 h-4 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
              </summary>
              <p class="mt-3 text-sm text-slate-300 leading-relaxed">{item.details}</p>
            </details>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
