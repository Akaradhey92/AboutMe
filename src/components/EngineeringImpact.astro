---
import { engineeringImpacts, platformContext } from '../data/impact';
import { Layers, CheckCircle2, ShieldCheck, Activity, GitBranch, Sparkles, Landmark } from 'lucide-astro';

const categoryConfig = {
  'Platform Modernization': {
    icon: Layers,
    badgeClass: 'bg-cyan-950/80 text-cyan-300 border-cyan-700/60',
    iconClass: 'text-cyan-400 bg-cyan-950/70 border-cyan-800/70',
  },
  'Cloud & DevOps': {
    icon: GitBranch,
    badgeClass: 'bg-blue-950/80 text-blue-300 border-blue-700/60',
    iconClass: 'text-blue-400 bg-blue-950/70 border-blue-800/70',
  },
  'Security & Identity': {
    icon: ShieldCheck,
    badgeClass: 'bg-indigo-950/80 text-indigo-300 border-indigo-700/60',
    iconClass: 'text-indigo-400 bg-indigo-950/70 border-indigo-800/70',
  },
  'Production Resiliency': {
    icon: Activity,
    badgeClass: 'bg-amber-950/80 text-amber-300 border-amber-800/60',
    iconClass: 'text-amber-400 bg-amber-950/70 border-amber-800/70',
  },
  'Enterprise AI': {
    icon: Sparkles,
    badgeClass: 'bg-purple-950/80 text-purple-300 border-purple-700/60',
    iconClass: 'text-purple-400 bg-purple-950/70 border-purple-800/70',
  },
};
---

<section id="impact" class="py-16 sm:py-24 border-t border-slate-800/80 bg-[#060911] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 text-left">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-400 text-xs font-mono mb-4">
        <span>02 // ENGINEERING IMPACT</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Engineering Impact
      </h2>
      <p class="mt-3.5 text-base sm:text-lg text-slate-300 leading-relaxed">
        Selected engineering initiatives across enterprise modernization, cloud delivery, identity integration, production reliability and AI-enabled workflows.
      </p>
    </div>

    <!-- Enterprise Platform Context Callout -->
    <div class="mb-12 rounded-xl bg-gradient-to-r from-navy-900/90 to-[#0c1424] border border-cyan-900/40 p-6 sm:p-7 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-start gap-4">
        <div class="w-10 h-10 rounded-lg bg-cyan-950 text-cyan-400 border border-cyan-800/70 flex items-center justify-center flex-shrink-0">
          <Landmark class="w-5 h-5" />
        </div>
        <div class="space-y-2 text-left">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-cyan-400">
              Enterprise Domain Context
            </span>
            <span class="text-slate-600">•</span>
            <span class="text-xs text-slate-300 font-mono">
              {platformContext.company} // {platformContext.platformName}
            </span>
          </div>
          <p class="text-sm text-slate-200 leading-relaxed font-normal">
            {platformContext.summary}
          </p>
        </div>
      </div>
    </div>

    <!-- Impact Cards Grid (5 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {engineeringImpacts.map((item, idx) => {
        const config = categoryConfig[item.category] || categoryConfig['Platform Modernization'];
        const Icon = config.icon;
        const isWide = idx === engineeringImpacts.length - 1 && engineeringImpacts.length % 2 !== 0;

        return (
          <article
            class={`rounded-xl bg-navy-900/60 border border-slate-800/90 hover:border-slate-700 hover:bg-navy-850/60 p-6 sm:p-7 flex flex-col justify-between transition-all duration-200 ${
              isWide ? 'md:col-span-2 lg:col-span-2' : ''
            }`}
          >
            <div class="space-y-4">
              
              <!-- Card Header: Category & Icon -->
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <span class={`text-[11px] font-mono px-2.5 py-0.5 rounded-full border font-medium ${config.badgeClass}`}>
                  {item.category}
                </span>

                <div class={`w-8 h-8 rounded-lg border flex items-center justify-center ${config.iconClass}`}>
                  <Icon class="w-4 h-4" />
                </div>
              </div>

              <!-- Title & Tagline -->
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm font-mono text-cyan-300/90 mt-1 leading-snug">
                  {item.tagline}
                </p>
              </div>

              <!-- Challenge & Solution Breakdown -->
              <div class="space-y-3 pt-1">
                <div>
                  <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-400 block mb-1">
                    The Challenge & Scope
                  </span>
                  <p class="text-sm text-slate-300 leading-relaxed">
                    {item.challenge}
                  </p>
                </div>

                <div>
                  <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-cyan-400 block mb-1">
                    Architecture & Implementation
                  </span>
                  <p class="text-sm text-slate-300 leading-relaxed">
                    {item.solution}
                  </p>
                </div>
              </div>

              <!-- Tangible Outcomes -->
              <div class="pt-2 border-t border-slate-800/60 space-y-2">
                <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-400 block">
                  Key Outcomes & Contributions
                </span>
                <ul class="space-y-1.5">
                  {item.outcomes.map((outcome) => (
                    <li class="text-xs text-slate-200 flex items-start space-x-2 leading-relaxed">
                      <CheckCircle2 class="w-3.5 h-3.5 text-cyan-400 flex-shrink-0 mt-0.5" />
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>
              </div>

            </div>

            <!-- Technologies Footer -->
            <div class="pt-5 mt-6 border-t border-slate-800/80">
              <div class="flex flex-wrap gap-1.5">
                {item.technologies.map((tech) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

          </article>
        );
      })}
    </div>

  </div>
</section>
