---
import { siteConfig } from '../data/siteConfig';
import { withBase } from '../utils/url';
import { Menu, X, FileText, ChevronRight } from 'lucide-astro';

const resumeUrl = withBase(siteConfig.social.resumePdf);
const homeUrl = withBase('/');
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[#060911]/85 border-b border-slate-800/80 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Wordmark -->
      <a 
        href={homeUrl} 
        class="group flex items-center space-x-2 text-slate-100 font-semibold text-lg tracking-tight hover:text-cyan-400 transition-colors focus-visible:ring-2 focus-visible:ring-cyan-400 rounded-md py-1 px-1.5 -ml-1.5"
        aria-label={`${siteConfig.name} - Home`}
      >
        <span class="w-8 h-8 rounded-lg bg-linear-to-tr from-cyan-600 to-blue-600 flex items-center justify-center text-white font-mono font-bold text-sm shadow-xs group-hover:scale-105 transition-transform">
          A
        </span>
        <div class="flex flex-col">
          <span class="leading-none text-base font-bold tracking-tight text-white group-hover:text-cyan-300 transition-colors">
            {siteConfig.wordmark}
          </span>
          <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 leading-tight">
            Senior Engineer
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1 lg:space-x-2" aria-label="Main Navigation">
        {siteConfig.nav.map((item) => (
          <a
            href={withBase(`/${item.href}`)}
            class="px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-cyan-400 hover:bg-slate-800/50 rounded-md transition-colors focus-visible:ring-2 focus-visible:ring-cyan-400"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- CTA Action Button -->
      <div class="hidden lg:flex items-center space-x-3">
        <a
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center space-x-2 px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider text-cyan-300 bg-cyan-950/60 border border-cyan-800/80 hover:bg-cyan-900/40 hover:border-cyan-500 rounded-md transition-all shadow-xs focus-visible:ring-2 focus-visible:ring-cyan-400"
        >
          <FileText class="w-3.5 h-3.5" />
          <span>Resume</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center lg:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="inline-flex items-center justify-center p-2 rounded-md text-slate-400 hover:text-white hover:bg-slate-800/80 focus:outline-none focus:ring-2 focus:ring-cyan-400"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle navigation menu"
        >
          <Menu class="w-6 h-6 menu-icon-open" />
          <X class="w-6 h-6 menu-icon-close hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-slate-800 bg-[#0a0f1d] px-4 pt-2 pb-6 space-y-2 transition-all shadow-2xl"
  >
    <nav class="flex flex-col space-y-1" aria-label="Mobile Navigation">
      {siteConfig.nav.map((item) => (
        <a
          href={withBase(`/${item.href}`)}
          class="mobile-nav-link flex items-center justify-between px-3 py-2.5 rounded-md text-base font-medium text-slate-200 hover:text-cyan-400 hover:bg-slate-800/60 transition-colors"
        >
          <span>{item.label}</span>
          <ChevronRight class="w-4 h-4 text-slate-500" />
        </a>
      ))}
      <div class="pt-3 border-t border-slate-800">
        <a
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center space-x-2 w-full py-2.5 px-4 text-sm font-semibold uppercase tracking-wider text-cyan-300 bg-cyan-950/80 border border-cyan-700/80 hover:bg-cyan-900/60 rounded-md transition-all"
        >
          <FileText class="w-4 h-4" />
          <span>Download Resume</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = menuButton?.querySelector('.menu-icon-open');
  const iconClose = menuButton?.querySelector('.menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = menuButton?.getAttribute('aria-expanded') === 'true';
    menuButton?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  }

  function closeMenu() {
    menuButton?.setAttribute('aria-expanded', 'false');
    mobileMenu?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  menuButton?.addEventListener('click', toggleMenu);

  // Auto-close menu when a mobile nav link is clicked
  mobileLinks.forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu on ESC key press
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      menuButton.focus();
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) closeMenu();
  });
</script>

